{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and Cucumber BDD automation framework for SauceDemo",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "report": "node -e \"console.log('Open reports/cucumber-report.html in a browser')\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
